generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int              @id @default(autoincrement())
  name                String
  email               String           @unique
  password            String?
  phone               String?
  role                Role             @default(PASSENGER)
  warningCount        Int              @default(0)
  isBanned            Boolean          @default(false)
  banReason           String?
  banExpiryDate       DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  bookingRequests     BookingRequest[] @relation("PassengerBookings")
  rides               Ride[]
  seatBookings        SeatBooking[]
  driverComplaints    Complaint[]      @relation("DriverComplaints")
  passengerComplaints Complaint[]      @relation("PassengerComplaints")
  warnings            Warning[]
  notifications       Notification[]
}

model Ride {
  id               Int              @id @default(autoincrement())
  driverId         Int
  origin           String
  destination      String
  originLat        Float?
  originLng        Float?
  destinationLat   Float?
  destinationLng   Float?
  routeDistanceKm  Float?
  routeDurationMin Float?
  departureTime    DateTime
  seats            Int              @default(4)
  status           RideStatus       @default(PLANNED)
  totalFare        Float            @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  bookingRequests  BookingRequest[]
  driver           User             @relation(fields: [driverId], references: [id])
  seatBookings     SeatBooking[]
  complaints       Complaint[]
}

model BookingRequest {
  id          Int           @id @default(autoincrement())
  rideId      Int
  passengerId Int
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  passenger   User          @relation("PassengerBookings", fields: [passengerId], references: [id])
  ride        Ride          @relation(fields: [rideId], references: [id])

  @@unique([rideId, passengerId])
}

model SeatBooking {
  id            Int       @id @default(autoincrement())
  rideId        Int
  userId        Int
  seatNo        Int
  fare          Float
  paymentMethod String?
  paymentPhone  String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  ride          Ride      @relation(fields: [rideId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}

enum RideStatus {
  PLANNED
  ONGOING
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Complaint {
  id          Int      @id @default(autoincrement())
  driverId    Int
  passengerId Int
  rideId      Int
  title       String
  description String
  severity    String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  status      String   @default("PENDING") // PENDING, REVIEWED, RESOLVED, DISMISSED
  type        String   @default("DRIVER_COMPLAINT") // DRIVER_COMPLAINT, PASSENGER_COMPLAINT, SYSTEM_ISSUE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  driver    User      @relation("DriverComplaints", fields: [driverId], references: [id])
  passenger User      @relation("PassengerComplaints", fields: [passengerId], references: [id])
  ride      Ride      @relation(fields: [rideId], references: [id])
  warnings  Warning[]

  @@index([driverId])
  @@index([passengerId])
  @@index([rideId])
  @@index([status])
}

model Warning {
  id          Int      @id @default(autoincrement())
  passengerId Int
  complaintId Int
  message     String
  issuedBy    Int // Admin ID who issued the warning
  createdAt   DateTime @default(now())

  passenger User      @relation(fields: [passengerId], references: [id])
  complaint Complaint @relation(fields: [complaintId], references: [id])

  @@index([passengerId])
  @@index([complaintId])
}
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, DANGER
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}
